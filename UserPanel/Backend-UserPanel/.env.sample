
DATABASE_URL=postgresql://user:password@localhost:5432/mca_db
NODE_ENV=development
PORT=5046
# FastAPI Sentiment Analysis Service
FASTAPI_URL=http://127.0.0.1:8001

# OTP Configuration (feedback submit karne se pehle phone verify hota hai)
# Abhi disabled hai. Enable karne ke liye OTP_ENABLED=true + frontend me VITE_OTP_ENABLED=true
OTP_ENABLED=false
# twilio  -> real SMS via Twilio Verify (production me yahi use karein)
# console -> OTP server log me print hota hai (sirf local testing ke liye)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Twilio Console > Verify > Services se milta hai (VA... se start hota hai)
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# Reverse proxies ki sankhya (Render = 1, local direct = 0)
TRUST_PROXY=1

# Optional: global API rate limit (per IP, per 15 minutes)
RATE_LIMIT_MAX_REQUESTS=300
