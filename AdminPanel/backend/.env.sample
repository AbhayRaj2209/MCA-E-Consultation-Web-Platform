DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=5000
NODE_ENV=development

# FastAPI sentiment analysis service
FASTAPI_URL=http://127.0.0.1:8001
# Group summarisation model used by "Generate Overview"
GROUP_SUMMARY_URL=http://192.168.1.53:8364/api/summarize_group

# Authentication
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Optional: only allow sign-up from these email domains (comma separated). Empty = anyone can sign up.
ALLOWED_SIGNUP_DOMAINS=

# Number of reverse proxies in front of the server (Render = 1, local direct = 0)
TRUST_PROXY=1
